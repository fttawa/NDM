{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NDM",
  "version": "0.3.0",
  "identifier": "com.ndm.app",
  "build": {
    "beforeDevCommand": "pnpm build:bt-helper && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:bt-helper && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NDM",
        "width": 1200,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../extension/": "extension/",
      "licenses/": "licenses/",
      "bt-helper/native/": "bt-helper/"
    }
  }
}
